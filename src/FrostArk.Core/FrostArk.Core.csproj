<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>FrostArk.Core</AssemblyName>
    <RootNamespace>FrostArk.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- One source of truth: Unity compiles the very same C# under Assets. -->
    <Compile Include="../../Assets/FrostArk/Core/**/*.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
